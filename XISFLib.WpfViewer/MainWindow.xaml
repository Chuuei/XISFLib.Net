<Window x:Class="XISFLib.WpfViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XISFLib.WpfViewer"
        Title="XISF Library Workbench" Height="900" Width="1450" MinHeight="650" MinWidth="1050"
        Loaded="Window_Loaded">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:MetadataNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Value, StringFormat={}{0}}" Margin="8,0,0,0" Foreground="#606060"
                           TextWrapping="Wrap" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="16" BorderBrush="#404040" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,16,0,0"
                           Text="Open an XISF file or import a standard image to begin." TextWrapping="Wrap" Foreground="#606060" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="XISF Library Workbench" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <TextBlock Text="File" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FilePathTextBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="12,5"
                                    Click="BrowseButton_Click" />
                        </Grid>
                        <Button x:Name="LoadButton" Content="Load XISF or FITS" Padding="12,7" HorizontalAlignment="Stretch"
                                Click="LoadButton_Click" />
                        <Button x:Name="UnloadButton" Content="Unload image" Padding="12,7" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" Click="UnloadButton_Click" />
                        <Button x:Name="ImportButton" Content="Import PNG, JPEG, TIFF, BMP or GIF…" Padding="12,7"
                                Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="ImportButton_Click" />

                        <TextBlock Text="Image in document" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <ComboBox x:Name="ImageSelector" IsEnabled="False" SelectionChanged="ImageSelector_SelectionChanged" />
                        <TextBlock x:Name="ImageDetailsText" Margin="0,7,0,0" Foreground="#606060" TextWrapping="Wrap" />

                        <Separator Margin="0,20" />
                        <TextBlock Text="Display configuration" FontSize="16" FontWeight="SemiBold" />
                        <CheckBox x:Name="AutoStretchCheckBox" Content="Automatic screen stretch" IsChecked="True"
                                  Margin="0,12,0,0" Checked="StretchSetting_Changed" Unchecked="StretchSetting_Changed" />
                        <CheckBox x:Name="LinkChannelsCheckBox" Content="Link RGB channels" IsChecked="True"
                                  Margin="20,8,0,0" Checked="StretchSetting_Changed" Unchecked="StretchSetting_Changed" />

                        <TextBlock Text="Target background (0–1)" Margin="20,12,0,4" />
                        <TextBox x:Name="TargetBackgroundTextBox" Text="0.25" Margin="20,0,0,0"
                                 LostFocus="StretchValue_LostFocus" KeyDown="StretchValue_KeyDown" />

                        <TextBlock Text="Shadows clipping (≤ 0)" Margin="20,12,0,4" />
                        <TextBox x:Name="ShadowsClippingTextBox" Text="-2.8" Margin="20,0,0,0"
                                 LostFocus="StretchValue_LostFocus" KeyDown="StretchValue_KeyDown" />

                        <Button x:Name="ApplyButton" Content="Apply display settings" Margin="0,16,0,0" Padding="12,7"
                                Click="ApplyButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TabControl Grid.Column="1">
            <TabItem Header="Image">
                <Grid Background="#181818">
                    <TextBlock x:Name="EmptyViewText" Text="No image loaded" Foreground="#A0A0A0"
                               FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Margin="16" ClipToBounds="True">
                        <Grid x:Name="ImageViewport" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="ImageViewport_MouseLeftButtonDown"
                              MouseLeftButtonUp="ImageViewport_MouseLeftButtonUp"
                              MouseMove="ImageViewport_MouseMove"
                              MouseWheel="ImageViewport_MouseWheel"
                              LostMouseCapture="ImageViewport_LostMouseCapture">
                            <Image x:Name="ImageView" Stretch="Uniform" SnapsToDevicePixels="True"
                                   IsHitTestVisible="False" RenderTransformOrigin="0,0">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="ImageTranslateTransform" />
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Information">
                <Grid Background="#FAFAFA">
                    <TextBlock x:Name="EmptyMetadataText" Text="Load an XISF file to view its metadata."
                               Foreground="#606060" FontSize="16" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TreeView x:Name="MetadataTree" Margin="12" Background="Transparent"
                              BorderThickness="0" Visibility="Collapsed"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </TabItem>
            <TabItem Header="Image metadata">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Image attributes" FontSize="18" FontWeight="SemiBold" />
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <TextBlock Text="Identifier" VerticalAlignment="Center" /><TextBox x:Name="ImageIdTextBox" Margin="6,3" />
                            <TextBlock Text="Image type" VerticalAlignment="Center" /><ComboBox x:Name="ImageTypeComboBox" Margin="6,3" IsEditable="True" />
                            <TextBlock Text="Color space" VerticalAlignment="Center" /><ComboBox x:Name="ColorSpaceComboBox" Margin="6,3" IsEditable="True" />
                            <TextBlock Text="Orientation" VerticalAlignment="Center" /><ComboBox x:Name="OrientationComboBox" Margin="6,3" />
                            <TextBlock Text="Offset / pedestal" VerticalAlignment="Center" /><TextBox x:Name="OffsetTextBox" Margin="6,3" Text="0" />
                            <TextBlock Text="UUID" VerticalAlignment="Center" /><TextBox x:Name="UuidTextBox" Margin="6,3" />
                            <TextBlock Text="Resolution X" VerticalAlignment="Center" /><TextBox x:Name="ResolutionXTextBox" Margin="6,3" />
                            <TextBlock Text="Resolution Y" VerticalAlignment="Center" /><TextBox x:Name="ResolutionYTextBox" Margin="6,3" />
                            <TextBlock Text="Resolution unit" VerticalAlignment="Center" /><ComboBox x:Name="ResolutionUnitComboBox" Margin="6,3" />
                        </UniformGrid>

                        <TextBlock Text="Image properties" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <DataGrid x:Name="ImagePropertiesGrid" AutoGenerateColumns="False" CanUserAddRows="True" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Identifier" Binding="{Binding Id}" Width="2*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Types include String, Boolean, integer/float scalars, TimePoint and comma-separated vectors." Foreground="#606060" Margin="0,4,0,0" />

                        <TextBlock Text="FITS keywords" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <DataGrid x:Name="FitsKeywordsGrid" AutoGenerateColumns="False" CanUserAddRows="True" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
                                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Ancillary image metadata" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <UniformGrid Columns="4">
                            <TextBlock Text="CFA pattern" VerticalAlignment="Center" /><TextBox x:Name="CfaPatternTextBox" Margin="6,3" />
                            <TextBlock Text="CFA name" VerticalAlignment="Center" /><TextBox x:Name="CfaNameTextBox" Margin="6,3" />
                            <TextBlock Text="CFA width" VerticalAlignment="Center" /><TextBox x:Name="CfaWidthTextBox" Margin="6,3" />
                            <TextBlock Text="CFA height" VerticalAlignment="Center" /><TextBox x:Name="CfaHeightTextBox" Margin="6,3" />
                            <TextBlock Text="RGB gamma" VerticalAlignment="Center" /><TextBox x:Name="RgbGammaTextBox" Margin="6,3" />
                            <CheckBox x:Name="RgbSrgbCheckBox" Content="sRGB transfer" Margin="6,3" /><TextBlock />
                        </UniformGrid>
                        <TextBlock Text="RGB chromaticities (comma-separated)" Margin="0,8,0,2" /><TextBox x:Name="RgbChromaticitiesTextBox" />
                        <TextBlock Text="RGB luminance coefficients (comma-separated)" Margin="0,8,0,2" /><TextBox x:Name="RgbLuminanceTextBox" />
                        <TextBlock Text="Display function: midtones; shadows; highlights; low range; high range (four values per group)" Margin="0,8,0,2" />
                        <TextBox x:Name="DisplayFunctionTextBox" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Attach ICC profile…" Click="IccProfileButton_Click" Padding="10,5" />
                            <TextBlock x:Name="IccProfileText" Text="None" Margin="10,0,20,0" VerticalAlignment="Center" />
                            <Button Content="Set thumbnail…" Click="ThumbnailButton_Click" Padding="10,5" />
                            <TextBlock x:Name="ThumbnailText" Text="None" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="One image table" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <UniformGrid Columns="4"><TextBlock Text="Table identifier" VerticalAlignment="Center" /><TextBox x:Name="TableIdTextBox" Margin="6,3" /><TextBlock Text="Caption" VerticalAlignment="Center" /><TextBox x:Name="TableCaptionTextBox" Margin="6,3" /></UniformGrid>
                        <TextBlock Text="Fields, one per line: id|type|header|format" Margin="0,6,0,2" /><TextBox x:Name="TableFieldsTextBox" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Rows, one per line with | separated cells" Margin="0,6,0,2" /><TextBox x:Name="TableRowsTextBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Writer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="XISF writer configuration" FontSize="18" FontWeight="SemiBold" />
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <TextBlock Text="Compression" VerticalAlignment="Center" /><ComboBox x:Name="CompressionComboBox" Margin="6,3" />
                            <TextBlock Text="Checksum" VerticalAlignment="Center" /><ComboBox x:Name="ChecksumComboBox" Margin="6,3" />
                            <TextBlock Text="Creator application" VerticalAlignment="Center" /><TextBox x:Name="CreatorTextBox" Text="XISFLib.WpfViewer" Margin="6,3" />
                            <CheckBox x:Name="ShuffleCheckBox" Content="Byte shuffle" Margin="6,3" /><TextBlock />
                            <CheckBox x:Name="DistributedCheckBox" Content="Distributed .xish + .xisb output" Margin="6,3" Grid.ColumnSpan="2" /><TextBlock /><TextBlock />
                            <CheckBox x:Name="PreserveOriginalCheckBox" Content="Byte-identical copy of loaded XISF (ignore editor changes)" Margin="6,3" Grid.ColumnSpan="4" IsEnabled="False"
                                      ToolTip="Copies the loaded monolithic XISF without re-encoding it. Clear this option to apply metadata and writer settings." />
                        </UniformGrid>
                        <TextBlock Text="Document metadata" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <DataGrid x:Name="DocumentMetadataGrid" AutoGenerateColumns="False" CanUserAddRows="True" MinHeight="120">
                            <DataGrid.Columns><DataGridTextColumn Header="Identifier" Binding="{Binding Id}" Width="2*" /><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" /><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*" /></DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Document properties" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <DataGrid x:Name="DocumentPropertiesGrid" AutoGenerateColumns="False" CanUserAddRows="True" MinHeight="120">
                            <DataGrid.Columns><DataGridTextColumn Header="Identifier" Binding="{Binding Id}" Width="2*" /><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" /><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*" /></DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="SaveButton" Content="Save as XISF or FITS…" Padding="18,8" Click="SaveButton_Click" />
                            <Button Content="Validate loaded document" Padding="18,8" Margin="10,0,0,0" Click="ValidateButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Diagnostics">
                <Grid Margin="12">
                    <TextBlock x:Name="EmptyDiagnosticsText" Text="Save/reload or validate a document to see conformance diagnostics." Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <DataGrid x:Name="DiagnosticsGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                        <DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" /><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto" /><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" /></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>