<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="using:XISFLib.Viewer"
        x:Class="XISFLib.AvaloniaViewer.MainWindow" x:DataType="viewer:WorkbenchViewModel"
        Title="XISF Library Workbench — Avalonia" Icon="/Assets/space.ico" Width="1450" Height="900" MinWidth="1050" MinHeight="650">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="286,*">
    <Border Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource WorkbenchBorder}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="/Assets/space.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel><TextBlock Text="XISF Workbench" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="ASTRONOMY IMAGE STUDIO" Classes="eyebrow" FontSize="9" /></StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" MaxWidth="650" Margin="28,0" VerticalAlignment="Center">
          <TextBox Text="{Binding FilePath}" IsEnabled="{Binding CanInteract}" PlaceholderText="Open an XISF or FITS file…" ToolTip.Tip="Local astronomy file path" />
          <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0" IsEnabled="{Binding CanInteract}" />
          <Button Grid.Column="2" Content="Load file" Classes="primary" Command="{Binding LoadCommand}" Margin="8,0,0,0" />
        </Grid>
        <Button Grid.Column="2" x:Name="ImportButton" Content="Import raster…" Click="Import_Click" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" ToolTip.Tip="Import PNG, JPEG, TIFF, BMP or GIF" />
      </Grid>
    </Border>
    <Border Grid.Row="1" BorderBrush="{StaticResource WorkbenchBorder}" BorderThickness="0,0,1,0" Padding="14">
      <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="Third-party notices…" Click="Notices_Click" Margin="0,12,0,0" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="DOCUMENT" Classes="eyebrow" /><TextBlock Text="Selected image" FontSize="16" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ImageLabels}" SelectedIndex="{Binding SelectedImageIndex}" SelectionChanged="ImageSelection_Changed" IsEnabled="{Binding CanInteract}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding ImageDetails}" Classes="muted" TextWrapping="Wrap" /><Button Content="Unload image" Command="{Binding UnloadCommand}" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="PREVIEW" Classes="eyebrow" /><TextBlock Text="Display settings" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Spacing="8" IsEnabled="{Binding CanInteract}">
                  <CheckBox Content="Automatic stretch" IsChecked="{Binding AutoStretch}" IsCheckedChanged="DisplayToggle_Changed" />
                  <CheckBox Content="Link RGB channels" IsChecked="{Binding LinkChannels}" IsCheckedChanged="DisplayToggle_Changed" />
                  <Grid ColumnDefinitions="*,80" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Background (0–1)" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding TargetBackground}" KeyDown="Display_KeyDown" LostFocus="Display_LostFocus" />
                    <TextBlock Grid.Row="1" Text="Shadows (≤ 0)" VerticalAlignment="Center" Margin="0,8,0,0" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShadowsClipping}" KeyDown="Display_KeyDown" LostFocus="Display_LostFocus" Margin="0,8,0,0" />
                  </Grid>
                </StackPanel>
                <Button x:Name="ApplyDisplayButton" Content="Apply display" Command="{Binding ApplyCommand}" />
                <TextBlock Text="Preview adjustments leave scientific samples unchanged." Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Button Content="Finish &amp; share" Classes="primary" Click="Finish_Click" IsEnabled="{Binding CanEditMetadata}" ToolTip.Tip="Automatically prepare a picture to save as PNG or JPEG" />
            <StackPanel Margin="8,0" Spacing="5"><TextBlock Text="CANVAS NAVIGATION" Classes="eyebrow" /><TextBlock Text="Scroll to zoom · Drag to pan" Classes="muted" FontSize="12" /></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource WorkbenchBorder}" BorderThickness="0,1,0,0" Padding="20,9">
      <Grid ColumnDefinitions="Auto,*"><Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource WorkbenchAccent}" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Classes="muted" /></Grid>
    </Border>
    <TabControl x:Name="WorkbenchTabs" Grid.Row="1" Grid.Column="1" Margin="16,8,16,16" Background="White">
      <TabItem Header="Image">
        <Border Background="#111923" CornerRadius="8" ClipToBounds="True" Padding="16">
          <Grid x:Name="ImageViewport" Background="Transparent" ClipToBounds="True"
                PointerWheelChanged="Viewport_Wheel" PointerPressed="Viewport_Pressed"
                PointerMoved="Viewport_Moved" PointerReleased="Viewport_Released" PointerCaptureLost="Viewport_CaptureLost">
            <StackPanel x:Name="EmptyView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
              <Border Width="56" Height="56" CornerRadius="12" Background="#1E303D" HorizontalAlignment="Center">
                <TextBlock Text="✦" Foreground="#7DD3C8" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Your next discovery starts here" Foreground="#E2E8F0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Open an XISF or FITS file, or import a raster image." Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>
            <Image x:Name="ImageView" Stretch="Uniform" IsHitTestVisible="False" RenderTransformOrigin="0%,0%">
              <Image.RenderTransform>
                <TransformGroup><ScaleTransform /><TranslateTransform /></TransformGroup>
              </Image.RenderTransform>
            </Image>
          </Grid>
        </Border>
      </TabItem>
      <TabItem Header="Information">
        <Grid>
        <TextBlock Text="Load an XISF or FITS file to view its metadata." IsVisible="{Binding !HasMetadata}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource WorkbenchMuted}" />
        <TreeView x:Name="MetadataTree" Margin="24" ItemsSource="{Binding Metadata}" IsVisible="{Binding HasMetadata}">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="viewer:MetadataNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="viewer:MetadataNode" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DisplayValue}" Foreground="{StaticResource WorkbenchMuted}" TextWrapping="NoWrap" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        </Grid>
      </TabItem>
      <TabItem Header="Utilities">
        <ScrollViewer>
          <StackPanel Margin="24,8,24,24" Spacing="10" MaxWidth="1100" HorizontalAlignment="Left" IsEnabled="{Binding CanEditMetadata}">
            <TextBlock Text="Astronomy metadata" Classes="section" />
            <DataGrid x:Name="AstronomyGrid" ItemsSource="{Binding Utilities.Overview}" IsReadOnly="True" AutoGenerateColumns="False" Height="210">
              <DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{ReflectionBinding Name}" Width="220" /><DataGridTextColumn Header="Value" Binding="{ReflectionBinding Value}" Width="*" /></DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Channel statistics" Classes="section" />
            <WrapPanel>
              <TextBlock Text="Maximum samples per channel" Margin="0,0,8,0" />
              <TextBox Text="{Binding Utilities.SampleLimit}" Width="110" />
              <CheckBox Content="Normalize through image bounds" IsChecked="{Binding Utilities.Normalize}" Margin="8,0" />
              <Button x:Name="StatisticsButton" Content="Calculate statistics" Command="{Binding Utilities.StatisticsCommand}" />
            </WrapPanel>
            <DataGrid x:Name="StatisticsGrid" ItemsSource="{Binding Utilities.Statistics}" IsReadOnly="True" AutoGenerateColumns="False" Height="180">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Channel" Binding="{ReflectionBinding Channel}" /><DataGridTextColumn Header="Samples" Binding="{ReflectionBinding SampleCount}" />
                <DataGridTextColumn Header="Finite" Binding="{ReflectionBinding FiniteCount}" /><DataGridTextColumn Header="Non-finite" Binding="{ReflectionBinding NonFiniteCount}" />
                <DataGridTextColumn Header="Minimum" Binding="{ReflectionBinding Minimum}" /><DataGridTextColumn Header="Maximum" Binding="{ReflectionBinding Maximum}" />
                <DataGridTextColumn Header="Mean" Binding="{ReflectionBinding Mean}" /><DataGridTextColumn Header="Std. dev." Binding="{ReflectionBinding StandardDeviation}" />
                <DataGridTextColumn Header="Median" Binding="{ReflectionBinding Median}" /><DataGridTextColumn Header="MAD" Binding="{ReflectionBinding MedianAbsoluteDeviation}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Histogram" Classes="section" />
            <WrapPanel>
              <TextBlock Text="Channel" Margin="0,0,8,0" /><ComboBox ItemsSource="{Binding Utilities.Channels}" SelectedItem="{Binding Utilities.Channel}" Width="70" />
              <TextBlock Text="Bins" Margin="12,0,8,0" /><TextBox Text="{Binding Utilities.Bins}" Width="85" />
              <Button Content="Calculate histogram" Command="{Binding Utilities.HistogramCommand}" Margin="8,0" />
            </WrapPanel>
            <TextBlock Text="{Binding Utilities.HistogramSummary}" TextWrapping="Wrap" />
            <DataGrid ItemsSource="{Binding Utilities.Histogram}" IsReadOnly="True" AutoGenerateColumns="False" Height="240">
              <DataGrid.Columns><DataGridTextColumn Header="Bin" Binding="{ReflectionBinding Index}" /><DataGridTextColumn Header="Lower edge" Binding="{ReflectionBinding LowerEdge}" Width="*" /><DataGridTextColumn Header="Upper edge" Binding="{ReflectionBinding UpperEdge}" Width="*" /><DataGridTextColumn Header="Count" Binding="{ReflectionBinding Count}" Width="*" /></DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Region and channel access" Classes="section" />
            <WrapPanel>
              <TextBlock Text="X" Margin="0,0,8,0" /><TextBox Text="{Binding Utilities.RegionX}" Width="65" />
              <TextBlock Text="Y" Margin="8,0,8,0" /><TextBox Text="{Binding Utilities.RegionY}" Width="65" />
              <TextBlock Text="Width" Margin="8,0,8,0" /><TextBox Text="{Binding Utilities.RegionWidth}" Width="65" />
              <TextBlock Text="Height" Margin="8,0,8,0" /><TextBox Text="{Binding Utilities.RegionHeight}" Width="65" />
              <Button Content="Read interleaved region" Command="{Binding Utilities.RegionCommand}" Margin="8,0" />
              <Button Content="Read selected channel" Command="{Binding Utilities.ChannelCommand}" />
            </WrapPanel>
            <TextBox Text="{Binding Utilities.Samples, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" />
            <TextBlock Text="FITS celestial WCS (zero-based pixels)" Classes="section" />
            <TextBlock Text="{Binding Utilities.WcsSummary}" TextWrapping="Wrap" />
            <WrapPanel>
              <TextBlock Text="Pixel X" Margin="0,0,8,0" /><TextBox Text="{Binding Utilities.PixelX}" Width="110" />
              <TextBlock Text="Pixel Y" Margin="8,0,8,0" /><TextBox Text="{Binding Utilities.PixelY}" Width="110" />
              <Button Content="Pixel → sky" Command="{Binding Utilities.PixelToSkyCommand}" Margin="8,0" />
              <TextBlock Text="{Binding Utilities.PixelResult}" Margin="8,0,0,0" />
            </WrapPanel>
            <WrapPanel>
              <TextBlock Text="RA (degrees)" Margin="0,0,8,0" /><TextBox Text="{Binding Utilities.RightAscension}" Width="110" />
              <TextBlock Text="Dec (degrees)" Margin="8,0,8,0" /><TextBox Text="{Binding Utilities.Declination}" Width="110" />
              <Button Content="Sky → pixel" Command="{Binding Utilities.SkyToPixelCommand}" Margin="8,0" />
              <TextBlock Text="{Binding Utilities.SkyResult}" Margin="8,0,0,0" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Image metadata">
        <ScrollViewer>
        <StackPanel Margin="24" Spacing="14" MaxWidth="1000" HorizontalAlignment="Left" IsEnabled="{Binding CanEditMetadata}"><TextBlock Text="Image metadata" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Edit attributes, attachments and properties of the selected image." Classes="muted" />
          <Expander Header="Image attributes and resolution" HorizontalAlignment="Stretch">
            <Grid Classes="fieldRows" HorizontalAlignment="Left" ColumnDefinitions="152,160,144,160" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="16">
              <TextBlock Text="Identifier" /><TextBox x:Name="ImageIdEditor" Grid.Column="1" Text="{Binding ImageEditor.Id}" />
              <TextBlock Classes="rightLabel" Grid.Column="2" Text="Image type" /><TextBox Grid.Column="3" Text="{Binding ImageEditor.ImageType}" PlaceholderText="Light, Dark, Flat, Bias…" />
              <TextBlock Grid.Row="1" Text="Color space" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ImageEditor.ColorSpace}" PlaceholderText="Gray, RGB or CIELab" />
              <TextBlock Classes="rightLabel" Grid.Row="1" Grid.Column="2" Text="Orientation" /><TextBox x:Name="OrientationEditor" Grid.Row="1" Grid.Column="3" Text="{Binding ImageEditor.Orientation}" PlaceholderText="0, flip, 90, 90;flip…" />
              <TextBlock Grid.Row="2" Text="Offset" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ImageEditor.Offset}" />
              <TextBlock Classes="rightLabel" Grid.Row="2" Grid.Column="2" Text="UUID (version 4)" /><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ImageEditor.Uuid}" />
              <TextBlock Grid.Row="3" Text="Horizontal resolution" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ImageEditor.ResolutionX}" />
              <TextBlock Classes="rightLabel" Grid.Row="3" Grid.Column="2" Text="Vertical resolution" /><TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ImageEditor.ResolutionY}" />
              <TextBlock Grid.Row="4" Text="Resolution unit" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ImageEditor.ResolutionUnit}" PlaceholderText="inch or cm" />
            </Grid>
          </Expander>
          <Expander Header="CFA, RGB working space and display function" HorizontalAlignment="Stretch">
            <StackPanel Margin="16" Spacing="8">
              <Grid Classes="fieldRows" HorizontalAlignment="Left" ColumnDefinitions="152,160,144,160" RowDefinitions="Auto,Auto">
                <TextBlock Text="CFA pattern" /><TextBox Grid.Column="1" Text="{Binding ImageEditor.CfaPattern}" PlaceholderText="Blank removes CFA" />
                <TextBlock Classes="rightLabel" Grid.Column="2" Text="CFA name" /><TextBox Grid.Column="3" Text="{Binding ImageEditor.CfaName}" />
                <TextBlock Grid.Row="1" Text="CFA width" /><TextBox x:Name="CfaWidthEditor" Grid.Row="1" Grid.Column="1" Text="{Binding ImageEditor.CfaWidth}" />
                <TextBlock Classes="rightLabel" Grid.Row="1" Grid.Column="2" Text="CFA height" /><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ImageEditor.CfaHeight}" />
              </Grid>
              <TextBlock Text="RGB gamma (blank removes working space)" />
              <TextBox Text="{Binding ImageEditor.Gamma}" Width="140" HorizontalAlignment="Left" />
              <CheckBox Content="sRGB transfer function" IsChecked="{Binding ImageEditor.IsSrgb}" />
              <TextBlock Text="Primary x chromaticities: three comma-separated values" /><TextBox Text="{Binding ImageEditor.ChromaticityX}" Width="520" HorizontalAlignment="Left" />
              <TextBlock Text="Primary y chromaticities: three comma-separated values" /><TextBox Text="{Binding ImageEditor.ChromaticityY}" Width="520" HorizontalAlignment="Left" />
              <TextBlock Text="Luminance coefficients (recomputed from primaries on Apply)" /><TextBox Text="{Binding ImageEditor.Luminance}" Width="520" HorizontalAlignment="Left" />
              <TextBlock Text="Display function: m; s; h; l; r, each with four comma-separated values. Blank removes it." TextWrapping="Wrap" />
              <TextBox Text="{Binding ImageEditor.DisplayFunction}" AcceptsReturn="True" MinHeight="55" />
            </StackPanel>
          </Expander>
          <Expander Header="First image table" HorizontalAlignment="Stretch">
            <StackPanel Margin="8" Spacing="8">
              <TextBlock Text="{Binding TableEditor.Notice}" TextWrapping="Wrap" />
              <StackPanel Spacing="8" IsEnabled="{Binding TableEditor.CanEdit}">
                <TextBlock Text="Identifier" /><TextBox x:Name="TableIdEditor" Text="{Binding TableEditor.Id}" />
                <TextBlock Text="Caption" /><TextBox Text="{Binding TableEditor.Caption}" />
                <TextBlock Text="Fields: id|type|header|format, one per line" />
                <TextBox x:Name="TableFieldsEditor" Text="{Binding TableEditor.Fields}" AcceptsReturn="True" Height="90" />
                <TextBlock Text="Rows: one per line, | separated cells" />
                <TextBox x:Name="TableRowsEditor" Text="{Binding TableEditor.Rows}" AcceptsReturn="True" Height="110" />
              </StackPanel>
            </StackPanel>
          </Expander>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Attach ICC profile…" Click="Icc_Click" />
            <TextBlock Text="{Binding IccProfileDescription}" VerticalAlignment="Center" />
            <Button Content="Set thumbnail…" Click="Thumbnail_Click" />
            <TextBlock Text="{Binding ThumbnailDescription}" VerticalAlignment="Center" />
          </StackPanel>
        <Grid Height="620" RowDefinitions="Auto,Auto,*,Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Image properties" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Content="Add property" Click="AddProperty_Click" />
            <Button Content="Remove selected" Click="RemoveProperty_Click" />
            <Button x:Name="ApplyMetadataButton" Classes="primary" Content="Apply metadata edits" Click="ApplyMetadata_Click" />
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Text="Apply changes the working image. Switching images discards unapplied edits. Open a value to inspect or edit it in pages. Unsupported types remain read-only." />
            <TextBlock Text="{ReflectionBinding #ImagePropertiesGrid.SelectedItem.IdentifierPreview}" TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="24" />
          </StackPanel>
          <DataGrid x:Name="ImagePropertiesGrid" RowHeight="28" DoubleTapped="PropertyValue_DoubleTapped" Grid.Row="2" ItemsSource="{Binding ImageProperties}" AutoGenerateColumns="False" BeginningEdit="Properties_BeginningEdit">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{ReflectionBinding Id}" Width="2*" MinWidth="140" />
              <DataGridTextColumn Header="Type" Binding="{ReflectionBinding Type}" Width="110" />
              <DataGridTextColumn Header="Value" Binding="{ReflectionBinding InlineValue}" Width="3*" MinWidth="180" /><DataGridTemplateColumn Header="Inspect" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Open…" Click="OpenPropertyValue_Click" Padding="4,0" MinHeight="0" Height="24" Margin="0,1" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,8">
            <TextBlock Text="FITS keywords" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Content="Add keyword" Click="AddKeyword_Click" />
            <Button Content="Remove selected" Click="RemoveKeyword_Click" />
          </StackPanel>
          <DataGrid x:Name="FitsKeywordsGrid" Grid.Row="4" ItemsSource="{Binding FitsKeywords}" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{ReflectionBinding Name}" Width="*" />
              <DataGridTextColumn Header="Value (FITS text)" Binding="{ReflectionBinding Value}" Width="2*" />
              <DataGridTextColumn Header="Comment" Binding="{ReflectionBinding Comment}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Writer"><ScrollViewer>
        <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,200,Auto,200" IsEnabled="{Binding CanEditMetadata}">
          <StackPanel Spacing="10" Margin="0,0,0,16"><TextBlock Text="Save &amp; export" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Re-encoding writes the selected image. Byte-identical copy preserves the whole source and ignores editor changes." TextWrapping="Wrap" />
            <WrapPanel>
              <TextBlock Text="Compression" Margin="0,0,8,0" />
              <ComboBox ItemsSource="{Binding CompressionChoices}" SelectedItem="{Binding Compression}" Width="140" />
              <TextBlock Text="Checksum" Margin="12,0,8,0" />
              <ComboBox ItemsSource="{Binding ChecksumChoices}" SelectedItem="{Binding Checksum}" Width="140" />
              <CheckBox Content="Shuffle" IsChecked="{Binding Shuffle}" Margin="12,0" />
              <CheckBox Content="Distributed XISF" IsChecked="{Binding Distributed}" Margin="12,0" />
            </WrapPanel>
            <CheckBox Content="Byte-identical copy (ignore editor changes)" IsChecked="{Binding PreserveOriginal}" IsEnabled="{Binding CanCopyOriginal}" />
            <Button x:Name="SaveButton" Classes="primary" Content="Save astronomy image…" Click="Save_Click" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Creator application" VerticalAlignment="Center" />
            <TextBox Text="{Binding DocumentEditor.CreatorApplication}" Width="300" />
            <Button x:Name="ApplyDocumentButton" Content="Apply document edits" Click="ApplyDocument_Click" />
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Document metadata" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Content="Add" Click="AddDocumentMetadata_Click" />
            <Button Content="Remove selected" Click="RemoveDocumentMetadata_Click" />
          </StackPanel>
          <DataGrid x:Name="DocumentMetadataGrid" RowHeight="28" DoubleTapped="PropertyValue_DoubleTapped" Grid.Row="3" ItemsSource="{Binding DocumentEditor.Metadata}" AutoGenerateColumns="False" BeginningEdit="Properties_BeginningEdit">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{ReflectionBinding Id}" Width="2*" MinWidth="140" />
              <DataGridTextColumn Header="Type" Binding="{ReflectionBinding Type}" Width="110" />
              <DataGridTextColumn Header="Value" Binding="{ReflectionBinding InlineValue}" Width="3*" MinWidth="180" /><DataGridTemplateColumn Header="Inspect" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Open…" Click="OpenPropertyValue_Click" Padding="4,0" MinHeight="0" Height="24" Margin="0,1" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Rows" Binding="{ReflectionBinding Rows}" Width="90" />
              <DataGridTextColumn Header="Columns" Binding="{ReflectionBinding Columns}" Width="90" />
              <DataGridTextColumn Header="Format" Binding="{ReflectionBinding Format}" Width="110" />
              <DataGridTextColumn Header="Comment" Binding="{ReflectionBinding Comment}" Width="160" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,8">
            <TextBlock Text="Document properties" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Content="Add" Click="AddDocumentProperty_Click" />
            <Button Content="Remove selected" Click="RemoveDocumentProperty_Click" />
          </StackPanel>
          <DataGrid x:Name="DocumentPropertiesGrid" RowHeight="28" DoubleTapped="PropertyValue_DoubleTapped" Grid.Row="5" ItemsSource="{Binding DocumentEditor.Properties}" AutoGenerateColumns="False" BeginningEdit="Properties_BeginningEdit">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{ReflectionBinding Id}" Width="2*" MinWidth="140" />
              <DataGridTextColumn Header="Type" Binding="{ReflectionBinding Type}" Width="110" />
              <DataGridTextColumn Header="Value" Binding="{ReflectionBinding InlineValue}" Width="3*" MinWidth="180" /><DataGridTemplateColumn Header="Inspect" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Open…" Click="OpenPropertyValue_Click" Padding="4,0" MinHeight="0" Height="24" Margin="0,1" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Rows" Binding="{ReflectionBinding Rows}" Width="90" />
              <DataGridTextColumn Header="Columns" Binding="{ReflectionBinding Columns}" Width="90" />
              <DataGridTextColumn Header="Format" Binding="{ReflectionBinding Format}" Width="110" />
              <DataGridTextColumn Header="Comment" Binding="{ReflectionBinding Comment}" Width="160" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid></ScrollViewer>
      </TabItem>
      <TabItem Header="Statistics">
        <ScrollViewer>
          <StackPanel Margin="24" Spacing="14">
            <TextBlock Text="Image quality" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Measure stars, background, noise and clipping in the selected image. Compare exposures using the same channel and detection threshold." TextWrapping="Wrap" Classes="muted" />
            <WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanEditMetadata}">
                <TextBlock Text="Channel (zero-based)" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Quality.Channels}" SelectedItem="{Binding Quality.Channel}" Width="80" />
                <TextBlock Text="Detection threshold (σ)" VerticalAlignment="Center" />
                <TextBox Text="{Binding Quality.DetectionThreshold}" Width="70" />
              </StackPanel>
              <Button x:Name="AnalyzeQualityButton" Content="Analyze image" Classes="primary" Command="{Binding Quality.AnalyzeCommand}" Margin="12,0,0,0" />
              <Button Content="Cancel analysis" Command="{Binding Quality.CancelCommand}" IsEnabled="{Binding Quality.AnalyzeCommand.IsRunning}" Margin="8,0,0,0" />
            </WrapPanel>
            <TextBlock Text="{Binding Quality.Notes}" TextWrapping="Wrap" />
            <DataGrid x:Name="QualityMetricsGrid" ItemsSource="{Binding Quality.Entries}" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="36" Height="470">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Metric" Binding="{ReflectionBinding Name}" Width="235" />
                <DataGridTextColumn Header="Value" Binding="{ReflectionBinding Value}" Width="230" />
                <DataGridTemplateColumn Header="Meaning / method" Width="*" MinWidth="260">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="viewer:QualityEntry"><TextBlock Text="{Binding Explanation}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Explanation}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Channel statistics (stored units, up to 65,536 systematic samples per channel)" Classes="section" TextWrapping="Wrap" />
            <DataGrid x:Name="QualityChannelsGrid" ItemsSource="{Binding Quality.Statistics}" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="28" Height="170">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Channel" Binding="{ReflectionBinding Channel}" />
                <DataGridTextColumn Header="Samples" Binding="{ReflectionBinding SampleCount}" />
                <DataGridTextColumn Header="Non-finite" Binding="{ReflectionBinding NonFiniteCount}" />
                <DataGridTextColumn Header="Minimum" Binding="{ReflectionBinding Minimum}" />
                <DataGridTextColumn Header="Maximum" Binding="{ReflectionBinding Maximum}" />
                <DataGridTextColumn Header="Mean" Binding="{ReflectionBinding Mean}" />
                <DataGridTextColumn Header="Std. dev." Binding="{ReflectionBinding StandardDeviation}" />
                <DataGridTextColumn Header="Median" Binding="{ReflectionBinding Median}" />
                <DataGridTextColumn Header="MAD" Binding="{ReflectionBinding MedianAbsoluteDeviation}" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="FinishTab" Header="Finish &amp; share">
        <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Make a picture to share" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="One click trims empty edges, reduces uneven sky glow and brings out faint detail against a dark background. Review the result, then save your picture." TextWrapping="Wrap" Classes="muted" />
            <StackPanel Orientation="Horizontal" Spacing="20" IsEnabled="{Binding CanInteract}">
              <CheckBox x:Name="ReduceNoiseCheckBox" Content="Reduce noise" IsChecked="{Binding Finish.ReduceNoise}"
                        ToolTip.Tip="Automatically reduce fine grain and colored speckles in noisy stacks. Turn off to retain more faint texture." />
              <CheckBox x:Name="SharpenStarsCheckBox" Content="Sharpen stars" IsChecked="{Binding Finish.SharpenStars}"
                        ToolTip.Tip="Gentle automatic deconvolution of isolated stars; saturated or poorly resolved stars are skipped." />
              <CheckBox x:Name="ReduceStarSpikesCheckBox" Content="Reduce star spikes" IsChecked="{Binding Finish.ReduceStarSpikes}"
                        ToolTip.Tip="Soften supported narrow rays around bright stars. Broad halos remain; turn off if nearby detail is affected." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="CreateFinishedButton" Content="Create finished image" Classes="primary" Command="{Binding Finish.CreateCommand}" />
              <Button x:Name="CancelFinishedButton" Content="Cancel" Command="{Binding Finish.CancelCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Finish.Summary}" TextWrapping="Wrap" />
            <StackPanel x:Name="FinishProgressPanel" Spacing="6" IsVisible="{Binding Finish.IsProcessing}">
              <TextBlock x:Name="FinishProgressText" Text="{Binding Finish.ProgressText}" TextWrapping="Wrap" />
              <ProgressBar x:Name="FinishProgressBar" Minimum="0" Maximum="100" Value="{Binding Finish.ProgressValue}"
                           IsIndeterminate="{Binding Finish.IsIndeterminate}" Height="6" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Row="2" Background="#111923" CornerRadius="8" ClipToBounds="True" Padding="12">
            <Grid x:Name="FinishedViewport" Background="Transparent" ClipToBounds="True"
                  PointerWheelChanged="Viewport_Wheel" PointerPressed="Viewport_Pressed"
                  PointerMoved="Viewport_Moved" PointerReleased="Viewport_Released" PointerCaptureLost="Viewport_CaptureLost">
              <TextBlock Text="Your finished picture will appear here" Foreground="#94A3B8" IsVisible="{Binding !Finish.HasPicture}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="FinishedImageView" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"
                     IsHitTestVisible="False" RenderTransformOrigin="0%,0%">
                <Image.RenderTransform>
                  <TransformGroup><ScaleTransform /><TranslateTransform /></TransformGroup>
                </Image.RenderTransform>
              </Image>
            </Grid>
          </Border>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Text="Your original stays intact. PNG keeps every finished pixel; JPEG makes a smaller file for sharing." TextWrapping="Wrap" Classes="muted" VerticalAlignment="Center" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="SaveFinishedPngButton" Content="Save PNG…" Click="SaveFinished_Click" Tag="png" IsEnabled="{Binding Finish.CanSave}" />
              <Button x:Name="SaveFinishedJpegButton" Content="Save JPEG…" Click="SaveFinished_Click" Tag="jpeg" IsEnabled="{Binding Finish.CanSave}" />
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Diagnostics">
        <DockPanel Margin="24">
        <Button DockPanel.Dock="Top" Content="Validate document" Command="{Binding ValidateCommand}" Margin="0,0,0,16" />
        <DataGrid ItemsSource="{Binding Diagnostics}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Severity" Binding="{ReflectionBinding Severity}" Width="Auto" />
            <DataGridTextColumn Header="Code" Binding="{ReflectionBinding Code}" Width="Auto" />
            <DataGridTextColumn Header="Message" Binding="{ReflectionBinding Message}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
