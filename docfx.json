{
  "metadata": [
    {
      "src": [
        { "files": ["XISFLib/XISFLib.csproj", "XISFLib.Windows/XISFLib.Windows.csproj"] }
      ],
      "dest": "docs/api"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["index.md", "README.md", "CONTRIBUTING.md", "THIRD-PARTY-NOTICES.md", "toc.yml", "docs/*.md", "docs/plans/*.md", "docs/toc.yml", "docs/api/**.yml"]
      }
    ],
    "resource": [{ "files": ["LICENSE", "NOTICE"] }],
    "dest": "docs/_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "XISFLib.Net",
      "_enableSearch": true
    }
  }
}
